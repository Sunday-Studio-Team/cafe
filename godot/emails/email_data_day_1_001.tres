[gd_resource type="Resource" script_class="EmailData" format=3 uid="uid://bbr8qpbfanc3b"]

[ext_resource type="Script" uid="uid://djk1v35hn3es4" path="res://emails/email_data.gd" id="1_vcbxk"]

[resource]
script = ExtResource("1_vcbxk")
day_to_send = 1
sender_name = "Management"
displayed_time = "7am"
subject = "The Future of The Company"
recipient_name = "Employee #000000"
contents = "Hi all,

We regularly evaluate our internal processes to ensure we are best positioned to meet the evolving demands of our customers and the industry.
At the end of the day, we need to get our ducks in a row.

We need to move the needle.
Our hearts go out to those impacted.
Let's think outside the box here.
Let's address the elephant in the room.
It's easy low-hanging fruit.
Let's go back to the drawing board.
Let's circle back to this.

From all of us at the company, we cannot thank you enough for joining us on this journey."
metadata/_custom_type_script = "uid://djk1v35hn3es4"

[resource]
script = ExtResource("1_j5nai")
day_to_send = 2
sender_name = "Management"
displayed_time = "7:30am"
subject = "Daily Insight"
recipient_name = "Employee #000000"
contents = "Dear Valued Employee,

Did you know Slip-and-Fall accidents account for the majority of workplace hazards in cafes? Not here at Tippy’s! We require human employees to comply with a brisk walking pace of no more than 3.5 mph. Anything exceeding a light jog will result in disciplinary action. Thank you for your continued service.

Tucker here. If you think I’m shelling out cash for your sorry ass, then you’re mistaken, kid. I don’t want to hear about any workplace injury. You can break a leg outside of work. "
metadata/_custom_type_script = "uid://djk1v35hn3es4"

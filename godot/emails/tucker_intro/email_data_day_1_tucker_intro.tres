[ext_resource type="Script" uid="uid://djk1v35hn3es4" path="res://emails/email_data.gd" id="2_igapc"]

[resource]
script = ExtResource("2_igapc")
day_to_send = 1
sender_name = "tuckerwertham@gmail.com"
displayed_time = "7am"
subject = "Congratulations"
recipient_name = "Employee #000000"
contents = "Dear Valued Employee,

Congratulations on your new role of AI Cafe Manager at Celeste AI Cafe, formerly King of Comics Cafe, a subsidiary of BOOGLE INC., the leading front of automated third spaces. Here it’s not just about the drinks– it’s about the customers. Our team is glad to have you onboard, and look forward to your continued tenure at [BOOGLE INC]. 

During your shift, please remember to adhere to company policy, and be mindful of the following rules; do not run in the hallway, let the machines handle the drinks, and always make the customer happy! Please note that failure to comply may result in immediate and uncompensated termination.

Be sure to utilize Tippy, our AI-powered Agent! Keep in mind, Tippy will be monitoring you to make sure you say thank you, and greet all the customers properly. 

You like that email? Oh yeah, it was drafted up in a nanosecond with Tippy! Effortless. Y’know, I don’t even need to contact you, but I decided, in all my grace, to personally write to YOU, so ya better appreciate it. Keep with me now, just stick to the rules, and you get to ride with me on the AI HYPE TRAIN! Front row seats included.

A cafe with no labor, what a breeze this business venture is gonna be, all I had to do was buy out some poor sods mediocre cafe. Haha, I’m assuming you're laughing with me. Don’t bother replying to me, my time is valuable, but Tippy here will be happy to respond. Good luck bud.

Yours truly, - Tucker Wertham 
"
metadata/_custom_type_script = "uid://djk1v35hn3es4"

script = ExtResource("1_fjlux")
username = "wakeup_people1"
rating = 1.0
review_content = "For those unaware, King of Comics has been sold, rebranded now to an AI cafe whose mascot could hold the truth behind the acquisition. What lies behind Tippy’s soulless veneer? Was this a money move, or something more sinister?

The machines break constantly… the robots mix up orders. Could Tippy be trying to sabotage itself on purpose, knowing its death would bring back the human connection this cafe once held?

Or is it using this cafe as a trial run, set on getting smarter and smarter until there’s no place left without his watchful eyes? 

Or maybe… Boogle just doesn’t know what they’re doing and AI still sucks.

Mark my words, I’ll uncover what’s going on here."
sprites = Array[AtlasTexture]([ExtResource("2_voa3p")])

[resource]
script = ExtResource("1_dheht")
username = "coconico"
rating = 2.0
review_content = "i've gone to this place for years now, and lately, it's really gone downhill. there used to be a bunch of friendly workers who always took care not to misgender me and, most importantly, make my drink exactly how i asked. it sucks to see just one worker left having to juggle cleaning, repairing machines that don't do their job correctly, and remaking drinks for upset customers. it's not fair that all of this falls onto one person; at least hire more people to help fix the machines' errors! the only reason i'm rating this place two stars is that the only worker i see there is so nice and took the time to remake my drink even though he was really busy. i miss the way that this cafe provided a sense of community. i hope all these bad reviews teach the manager or owner to change things. i really liked this place before all these bad changes were made.
"
customer_sprite_data_options = Array[ExtResource("1_0wpjt")]([ExtResource("2_0wpjt")])
metadata/_custom_type_script = "uid://djf3q4lwggw0g"

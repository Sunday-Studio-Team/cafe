[layer_names]

3d_render/layer_1="static_occluders"
3d_render/layer_2="dynamic_occluders"
3d_render/layer_3="player_camera_exclusives"
3d_physics/layer_1="environment"
3d_physics/layer_2="interactables"
3d_physics/layer_3="droppable"
3d_physics/layer_4="player"
3d_physics/layer_5="Trash"

[physics]

3d/run_on_separate_thread=true
3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/use_debanding=true
occlusion_culling/use_occlusion_culling=true

[sub_resource type="Shader" id="Shader_a3sl0"]
code = "shader_type spatial;

render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

const int TOTAL_IMAGES = 15;

uniform vec4 albedo : source_color;

uniform vec3 uv1_scale;
uniform vec3 uv1_offset;

uniform sampler2D tex_0 : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_1 : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_2 : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_3 : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_4 : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_5 : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_6 : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_7 : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_8 : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_9 : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_10 : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_11 : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_12 : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_13 : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_14 : source_color, filter_linear_mipmap, repeat_enable;

varying flat int instance_id;

void vertex() {
    instance_id = INSTANCE_ID;

    UV = UV * uv1_scale.xy + uv1_offset.xy;

    MODELVIEW_MATRIX = VIEW_MATRIX * mat4(
        MAIN_CAM_INV_VIEW_MATRIX[0],
        MAIN_CAM_INV_VIEW_MATRIX[1],
        MAIN_CAM_INV_VIEW_MATRIX[2],
        MODEL_MATRIX[3]
    );

    MODELVIEW_NORMAL_MATRIX = mat3(MODELVIEW_MATRIX);
}

void fragment() {
    vec2 base_uv = UV;

    int current_instance = instance_id % TOTAL_IMAGES;

    vec4 albedo_tex;

    if (current_instance == 0) {
        albedo_tex = texture(tex_0, base_uv);
    } else if (current_instance == 1) {
        albedo_tex = texture(tex_1, base_uv);
    } else if (current_instance == 2) {
        albedo_tex = texture(tex_2, base_uv);
    } else if (current_instance == 3) {
        albedo_tex = texture(tex_3, base_uv);
    } else if (current_instance == 4) {
        albedo_tex = texture(tex_4, base_uv);
    } else if (current_instance == 5) {
        albedo_tex = texture(tex_5, base_uv);
    } else if (current_instance == 6) {
        albedo_tex = texture(tex_6, base_uv);
    } else if (current_instance == 7) {
        albedo_tex = texture(tex_7, base_uv);
    } else if (current_instance == 8) {
        albedo_tex = texture(tex_8, base_uv);
    } else if (current_instance == 9) {
        albedo_tex = texture(tex_9, base_uv);
    } else if (current_instance == 10) {
        albedo_tex = texture(tex_10, base_uv);
    } else if (current_instance == 11) {
        albedo_tex = texture(tex_11, base_uv);
    } else if (current_instance == 12) {
        albedo_tex = texture(tex_12, base_uv);
    } else if (current_instance == 13) {
        albedo_tex = texture(tex_13, base_uv);
    } else if (current_instance == 14) {
        albedo_tex = texture(tex_14, base_uv);
    }

    ALBEDO = albedo.rgb * albedo_tex.rgb;
    ALPHA = albedo_tex.a;
    ALPHA_SCISSOR_THRESHOLD = 0.5;
}"

